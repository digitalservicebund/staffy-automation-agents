# ==================================
# Staffy Automation Agents Environment Configuration
# ==================================
# Never put real values here. Locally, values come from 1Password via
# .env.schema.local (copy .env.schema.example); in CI from GitHub Actions secrets.
# Run anything that needs them through varlock, e.g.
#   npx varlock run -- npx flue run src/agents/bugfix.ts --message "..."
# ==================================
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @import(./.env.schema.local, allowMissing=true)
# ==================================

# ==================================
# LLM (STACKIT AI Model Serving)
# ==================================

# Same OpenAI-compatible endpoint and key as Staffy's engagement-summary sync.
# @required @type=url
LLM_BASE_URL=
# @required @sensitive
LLM_API_KEY=

# ==================================
# Asana (MCP)
# ==================================

# Asana's V2 MCP server only accepts OAuth tokens from a pre-registered
# "MCP app" (no PATs, no dynamic client registration). Create the app at
# https://app.asana.com/0/my-apps, then run `npm run asana:auth` once to get
# the refresh token. Agents exchange it for short-lived access tokens.
# @required @sensitive
ASANA_MCP_CLIENT_ID=
# @required @sensitive
ASANA_MCP_CLIENT_SECRET=
# Only needed after `npm run asana:auth`, which is what produces it.
# @sensitive
ASANA_MCP_REFRESH_TOKEN=

# GID of the Asana project the bugfix agent triages (from the board URL).
# @required @sensitive
ASANA_BUG_PROJECT_GID=

# Comma-separated Asana user GIDs of people allowed to approve a merge by
# completing (or commenting on) a PR review subtask. See src/approval.ts.
# @required @sensitive
ASANA_APPROVER_GIDS=

# ==================================
# GitHub
# ==================================

# "Staffy Bot" GitHub App, installed on digitalservicebund/staffy only. The
# agent signs a JWT with the private key and exchanges it for short-lived
# installation tokens, so PRs and merges are attributed to the bot.
# @required @sensitive
GITHUB_APP_CLIENT_ID=
# Full PEM contents, including the BEGIN/END lines.
# @required @sensitive
GITHUB_APP_PRIVATE_KEY=
