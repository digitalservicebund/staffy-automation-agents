# ==================================
# Staffy Automation Agents Environment Configuration
# ==================================
# Copy this file to .env.schema.local and fill in your 1Password account and item.
# The example below loads all environment variables from a 1Password item using the @varlock/1password-plugin.
# It inherits all the settings and documentation from .env.schema, so you only need to add the plugin configuration and the @setValuesBulk directive.
# ==================================
#
# 1. Load the plugin
# @plugin(@varlock/1password-plugin)
#
# 2. Initialize the plugin
# @initOp(allowAppAuth=true, account=<YOUR_1PASSWORD_ACCOUNT_URL>)
#
# 3. Use the plugin to set environment variables from 1Password items
# @setValuesBulk(op(op://<VAULT_NAME>/<ITEM_NAME>/<FIELD_NAME>))
